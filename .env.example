# Copy to .env.local and fill in. Never commit .env.local.

# Firebase web config (Project settings > General > Your apps). Safe to expose in the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=   # browser key, HTTP-referrer restricted (Maps JavaScript API + Places API (New))
GOOGLE_MAPS_SERVER_KEY=            # server key (Places API (New) + Routes API)

# Gemini (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash      # use the latest Flash model listed in AI Studio

# Demo safety: serve saved responses instead of calling Gemini and Maps
DEMO_FIXTURES=false
